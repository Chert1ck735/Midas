# ArenaGo injects/replaces this variable in the competition deployment.
SANDBOX_API_KEY=
BOT_NAME=MoexAgent

# ArenaGo endpoint used by the API adapter.
ARENAGO_BASE_URL=https://arenago.ru

# Public quick start: fixed demo portfolio, no ArenaGo requests or orders.
DRY_RUN=true
# Set true only with SANDBOX_API_KEY: reads ArenaGo portfolio and keeps a local paper ledger.
PAPER_TRADING=false

# Runtime state. Set /data when running with a Docker volume.
DATA_DIR=./data
LOG_LEVEL=INFO

# Trading loop
POLL_INTERVAL_SECONDS=30
MAX_CYCLES=0

# Market data
# ALGOPACK token from data.moex.com. The Python client uses moexalgo.session.TOKEN.
MARKET_DATA_PROVIDER=iss
MOEX_ALGO_TOKEN=
CANDLE_PERIOD=10min
CANDLE_LOOKBACK_DAYS=5
USE_SUPER_CANDLES=true

# Risk limits
MAX_POSITION_PCT=0.15
MAX_PORTFOLIO_EXPOSURE_PCT=0.75
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.08
ORDER_CASH_PCT=0.03
MIN_CASH_PCT=0.10
MAX_DAILY_TRADES=30
SYMBOL_COOLDOWN_MINUTES=30
MIN_VOLUME_RATIO=0.30
MIN_TRADE_IMBALANCE_BUY=0.10
MIN_SUPER_VOLUME=1000
MIN_BOOK_IMBALANCE_BUY=-0.15
MAX_BOOK_SPREAD_PCT=0.01
ADD_POSITION_MIN_CONFIDENCE=0.64
ADD_POSITION_MIN_TRADE_IMBALANCE=0.20
ADD_POSITION_MIN_PNL_PCT=0.00
ADD_POSITION_MAX_POSITION_PCT=0.10
STOP_LOSS_PCT=0.007
TAKE_PROFIT_PCT=0.012
REVERSAL_EXIT_MIN_PNL_PCT=-0.003

# Optional LLM context layer. The app currently requires a non-empty key.
# POLZA_BASE_URL is the host root; the client adds /v1/chat/completions.
POLZA_API_KEY=
POLZA_BASE_URL=https://api.polza.ai
LLM_ENABLED=false

# Корень локальной выгрузки ALGOPACK в parquet (нужен только для микроструктуры)
ALGOPACK_LOCAL_ROOT=data/algopack

# Explicit current runtime defaults, not the historical best backtest config.
ML_FILTER_ENABLED=true
ML_MODEL_PATH=./data/models/lgbm_buy_filter_v5.joblib
ML_MIN_UP_PROBABILITY=0.58
ENABLE_SHORTS=true
ML_SHORT_MODEL_PATH=./data/models/lgbm_short_filter_v2.joblib
ML_MIN_DOWN_PROBABILITY=0.70
