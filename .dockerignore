# Only explicitly listed build inputs enter the Docker context.
**
!Dockerfile
!.dockerignore
!requirements.txt
!LICENSE
!src/
!src/**
!data/
!data/models/
!data/models/lgbm_buy_filter_v5.joblib
!data/models/lgbm_buy_filter_v5.meta.json
!data/models/lgbm_short_filter_v2.joblib
!data/models/lgbm_short_filter_v2.meta.json

# Exclude generated files even inside the source tree.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.env
**/.env.*
